# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=placeholder-vapid-public-key
VAPID_PRIVATE_KEY=placeholder-vapid-private-key
VAPID_MAILTO=mailto:placeholder@example.com

# Firebase Cloud Messaging (Android TWA push notifications)
# Paste the entire service account JSON as a single line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"placeholder"}

# Cron endpoint protection (optional but recommended)
CRON_SECRET=placeholder-cron-secret
