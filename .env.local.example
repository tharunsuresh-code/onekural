# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_MAILTO=mailto:you@example.com

# Firebase Cloud Messaging (Android TWA push notifications)
# Paste the entire service account JSON as a single line string
FIREBASE_SERVICE_ACCOUNT=<service-account-json>

# Cron endpoint protection (optional but recommended)
CRON_SECRET=<random-secret>
